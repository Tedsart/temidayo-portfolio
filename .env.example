# ---------------------------------------------------------------------------
# Temidayo Kukoyi — Portfolio + CMS
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project settings — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable / anon key (safe for the browser, protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key — SERVER ONLY. Used for admin writes and storage management.
# Keep out of any file imported by client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin of the deployed site. Used for canonical URLs, Open Graph
# images and the sitemap. On Vercel set this to https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage bucket that holds portfolio media (created by supabase/migrations).
SUPABASE_STORAGE_BUCKET=content

# Comma separated list of administrator emails. These users get full CMS access
# once they exist in Supabase Auth and are seeded into app.admin_users
# (see README → Authentication).
ADMIN_EMAILS=you@example.com

# Optional: where the contact form should deliver messages.
# If unset, the contact form renders as a pre-filled mailto link.
CONTACT_EMAIL=hello@example.com
